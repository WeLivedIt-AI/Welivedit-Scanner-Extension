{
  "manifest_version": 2,
  "name": "WeliveditAi X Scanner",
  "version": "5.0.2",
  "description": "WeLivedIt X helper. Sends the selected community_id and original-post account_id at request, post, and comment level for reliable database storage.",
  "permissions": [
    "storage",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://welivedit-ai-servicev2-production.up.railway.app/*",
    "https://welivedit-service-server-production-7991.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "icons/*.png"
  ]
}
